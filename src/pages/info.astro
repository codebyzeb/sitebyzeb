---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { BIO_LINKS, BIO_PARAGRAPHS } from '../data/info';
import { CONTACT_EMAIL, SOCIALS } from '../data/site';
import award from '../assets/info-award.jpg';
import portrait from '../assets/info-portrait.jpg';

// Inject bio links by matching link text
function withLinks(p: string): string {
  let out = p
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  for (const [text, href] of Object.entries(BIO_LINKS)) {
    if (out.includes(text)) {
      out = out.replace(
        text,
        `<a href="${href}" target="_blank" rel="noopener">${text}</a>`
      );
    }
  }
  return out;
}

// "find me" game, recreated from the original ReadyMag layout:
// the yellow instagram circle is the central anchor (topmost), with the
// red pill above, blue square lower-left, brown square right and green
// pill below — their inner edges tucked under the circle. The portrait and
// "you found me!" caption sit directly beneath the circle.
// Positions/sizes are percentages/cqw of the game container (420px wide,
// 705:606 aspect — same proportions as the original).
const chipPositions: Record<string, { x: string; y: string; r: string }> = {
  YouTube: { x: '34.8%', y: '29.5%', r: '-4deg' },
  email: { x: '17.2%', y: '43%', r: '-6deg' },
  Instagram: { x: '36.7%', y: '42.5%', r: '0deg' },
  TikTok: { x: '64.5%', y: '46%', r: '2deg' },
  LinkedIn: { x: '34%', y: '70.5%', r: '2deg' },
};

const chips = [
  { label: 'email', href: `mailto:${CONTACT_EMAIL}` },
  ...SOCIALS.map((s) => ({ label: s.label, href: s.href })),
].map((c) => ({ ...c, pos: chipPositions[c.label] }));
---

<BaseLayout title="Info">
  <section class="bio reveal">
    <Image
      class="bio-photo"
      src={award}
      alt="Zeb Goriely holding the Best Micro Short award at the BFI Future Film Festival"
      widths={[360, 640]}
      sizes="(max-width: 700px) 90vw, 380px"
      loading="eager"
    />
    <div class="bio-text">
      {BIO_PARAGRAPHS.map((p) => <p class="prose" set:html={withLinks(p)} />)}
    </div>
  </section>

  <section class="contact reveal">
    <h2 class="section-heading">Contact</h2>
    <p class="prose">
      Get in touch at
      <a class="contact-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </section>

  <section class="find-me reveal">
    <div class="find-game">
      <h2 class="find-heading">find me:</h2>
      <figure class="find-photo">
        <Image
          class="portrait"
          src={portrait}
          alt="Casual portrait of Zeb Goriely"
          widths={[160, 320]}
          sizes="19cqw"
          loading="lazy"
        />
      </figure>
      <p class="caption find-caption">you found me!</p>
      {chips.map((c) => (
        <a
          class:list={['chip', `chip--${c.label.toLowerCase()}`]}
          href={c.href}
          draggable="false"
          target={c.label === 'email' ? undefined : '_blank'}
          rel={c.label === 'email' ? undefined : 'noopener'}
          style={`--x: ${c.pos.x}; --y: ${c.pos.y}; --r: ${c.pos.r}`}
        >
          {c.label.toLowerCase()}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .bio {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2.25rem;
    max-width: 920px;
    margin: clamp(2rem, 6vw, 3rem) auto 0;
  }
  .bio-photo {
    flex: 0 0 auto;
    width: min(340px, 100%);
    aspect-ratio: 857 / 612; /* hard-lock the award photo's landscape crop */
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 14px 28px -14px rgba(34, 34, 34, 0.4);
  }
  .bio-text {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 0.9em;
    text-align: left;
  }

  .contact {
    text-align: center;
    margin: clamp(3rem, 8vw, 4.5rem) auto;
  }
  .contact-email {
    font-size: 1.15em;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.3em;
  }

  /* ---------- "find me" game (original ReadyMag layout) ---------- */

  .find-me { text-align: center; }

  .find-game {
    position: relative;
    width: min(420px, 100%);
    aspect-ratio: 705 / 606; /* same proportions as the original cluster */
    margin: 0 auto;
    container-type: inline-size; /* children size themselves in cqw */
    touch-action: pan-y;
  }
  .find-heading {
    position: absolute;
    left: 0;
    right: 0;
    top: 18.5%;
    font-size: 6cqw;
    font-weight: 400;
    text-align: center;
    margin: 0;
  }
  /* the portrait + caption live directly under the yellow circle —
     dragging it away is what reveals them */
  .find-photo {
    position: absolute;
    left: 51.7%; /* centre of the instagram circle */
    top: 60%;
    translate: -50% -50%;
    margin: 0;
  }
  .find-photo .portrait {
    width: 19cqw;
    height: 19cqw;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--ink);
    box-shadow: 0 10px 24px -12px rgba(34, 34, 34, 0.5);
  }
  .find-caption {
    position: absolute;
    left: 0;
    right: 0;
    top: 72.5%;
    margin: 0;
    font-size: 3.6cqw;
    white-space: nowrap;
  }

  .chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    rotate: var(--r);
    display: inline-grid;
    place-items: center;
    border: 2px solid var(--ink);
    font-family: var(--font-caption); /* Georgia, like the original buttons */
    font-size: 4.4cqw;
    text-decoration: none;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    z-index: 3;
    transition: rotate 0.25s ease, scale 0.25s ease;
  }
  .chip:hover { scale: 1.05; }
  .chip.is-dragging {
    cursor: grabbing;
    scale: 1.08;
    rotate: 0deg;
    z-index: 10;
    transition: none;
  }

  /* shapes + sizes from the original cluster (cqw = % of game width) */
  .chip--youtube {
    width: 33.6cqw;
    height: 14.2cqw;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
  }
  .chip--email {
    width: 20.6cqw;
    height: 20.6cqw;
    border-radius: 2px;
    background: var(--blue);
    color: #fff;
  }
  .chip--instagram {
    width: 30cqw;
    height: 30cqw;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    z-index: 6; /* the circle anchors the cluster and covers the photo */
  }
  .chip--tiktok {
    width: 18.4cqw;
    height: 18.4cqw;
    border-radius: 1.7cqw;
    background: var(--brown);
    color: #fff;
  }
  .chip--linkedin {
    width: 35cqw;
    height: 16.9cqw;
    border-radius: 999px;
    background: var(--green);
    color: #fff;
  }
</style>

<script>
  // "find me" game — drag the sticker chips to reveal the portrait.
  // A short drag suppresses the link's click; a plain tap still follows it.
  const game = document.querySelector<HTMLElement>('.find-game');
  if (game) {
    game.querySelectorAll<HTMLAnchorElement>('.chip').forEach((chip) => {
      let dragging = false;
      let moved = false;
      let sx = 0;
      let sy = 0;
      let bx = 0;
      let by = 0;

      chip.addEventListener('pointerdown', (e) => {
        e.preventDefault(); // stop native link-dragging and text selection
        dragging = true;
        moved = false;
        sx = e.clientX;
        sy = e.clientY;
        bx = chip.offsetLeft;
        by = chip.offsetTop;
        chip.setPointerCapture(e.pointerId);
        chip.classList.add('is-dragging');
      });
      chip.addEventListener('dragstart', (e) => e.preventDefault());

      chip.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - sx;
        const dy = e.clientY - sy;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true;
        const maxX = Math.max(game.clientWidth - chip.offsetWidth, 0);
        const maxY = Math.max(game.clientHeight - chip.offsetHeight, 0);
        chip.style.left = `${Math.min(Math.max(bx + dx, 0), maxX)}px`;
        chip.style.top = `${Math.min(Math.max(by + dy, 0), maxY)}px`;
      });

      const end = () => {
        dragging = false;
        chip.classList.remove('is-dragging');
      };
      chip.addEventListener('pointerup', end);
      chip.addEventListener('pointercancel', end);
      chip.addEventListener('click', (e) => {
        if (moved) e.preventDefault();
      });
    });
  }
</script>
