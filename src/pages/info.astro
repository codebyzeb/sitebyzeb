---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { BIO_LINKS, BIO_PARAGRAPHS } from '../data/info';
import { CONTACT_EMAIL, SOCIALS } from '../data/site';
import award from '../assets/info-award.jpg';
import portrait from '../assets/info-portrait.jpg';

// Inject bio links by matching link text
function withLinks(p: string): string {
  let out = p
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  for (const [text, href] of Object.entries(BIO_LINKS)) {
    if (out.includes(text)) {
      out = out.replace(
        text,
        `<a href="${href}" target="_blank" rel="noopener">${text}</a>`
      );
    }
  }
  return out;
}

// "find me" game: draggable sticker chips scattered over the portrait —
// move them aside to reveal the photo underneath.
const chipPositions: Record<string, { x: string; y: string; r: string }> = {
  email: { x: '36%', y: '24%', r: '-6deg' },
  YouTube: { x: '52%', y: '14%', r: '8deg' },
  Instagram: { x: '44%', y: '40%', r: '5deg' },
  TikTok: { x: '18%', y: '48%', r: '-3deg' },
  LinkedIn: { x: '26%', y: '66%', r: '-5deg' },
};

const chips = [
  { label: 'email', href: `mailto:${CONTACT_EMAIL}` },
  ...SOCIALS.map((s) => ({ label: s.label, href: s.href })),
].map((c) => ({ ...c, pos: chipPositions[c.label] }));
---

<BaseLayout title="Info">
  <section class="bio reveal">
    <Image
      class="bio-photo"
      src={award}
      alt="Zeb Goriely holding the Best Micro Short award at the BFI Future Film Festival"
      widths={[360, 640]}
      sizes="(max-width: 700px) 90vw, 380px"
      loading="eager"
    />
    <div class="bio-text">
      {BIO_PARAGRAPHS.map((p) => <p class="prose" set:html={withLinks(p)} />)}
    </div>
  </section>

  <section class="contact reveal">
    <h2 class="section-heading">Contact</h2>
    <p class="prose">
      Get in touch at
      <a class="contact-email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </section>

  <section class="find-me reveal">
    <h2 class="find-heading">find me:</h2>
    <p class="find-hint caption">drag the stickers around</p>
    <div class="find-game">
      <figure class="find-photo">
        <Image
          class="portrait"
          src={portrait}
          alt="Casual portrait of Zeb Goriely"
          widths={[160, 320]}
          sizes="130px"
          loading="lazy"
        />
        <figcaption class="caption">you found me!</figcaption>
      </figure>
      {chips.map((c) => (
        <a
          class:list={['chip', `chip--${c.label.toLowerCase()}`]}
          href={c.href}
          target={c.label === 'email' ? undefined : '_blank'}
          rel={c.label === 'email' ? undefined : 'noopener'}
          style={`--x: ${c.pos.x}; --y: ${c.pos.y}; --r: ${c.pos.r}`}
        >
          {c.label.toLowerCase()}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .bio {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2.25rem;
    max-width: 920px;
    margin: clamp(2rem, 6vw, 3rem) auto 0;
  }
  .bio-photo {
    flex: 0 1 340px;
    border-radius: 2px;
    box-shadow: 0 14px 28px -14px rgba(34, 34, 34, 0.4);
  }
  .bio-text {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 0.9em;
    text-align: left;
  }

  .contact {
    text-align: center;
    margin: clamp(3rem, 8vw, 4.5rem) auto;
  }
  .contact-email {
    font-size: 1.15em;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.3em;
  }

  /* ---------- "find me" game ---------- */

  .find-me { text-align: center; }
  .find-heading { font-size: var(--size-h3); font-weight: 400; }
  .find-hint { margin: 0.15rem 0 1rem; }

  .find-game {
    position: relative;
    width: min(360px, 100%);
    height: 340px;
    margin: 0 auto;
    touch-action: pan-y;
  }
  .find-photo {
    position: absolute;
    left: 50%;
    top: 44%;
    translate: -50% -50%;
    margin: 0;
  }
  .find-photo .portrait {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--ink);
    box-shadow: 0 10px 24px -12px rgba(34, 34, 34, 0.5);
  }
  .find-photo .caption { margin-top: 0.6rem; white-space: nowrap; }

  .chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    rotate: var(--r);
    display: inline-grid;
    place-items: center;
    border: 2px solid var(--ink);
    font-size: var(--size-small);
    text-decoration: none;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    z-index: 2;
    transition: rotate 0.25s ease, scale 0.25s ease;
  }
  .chip:hover { scale: 1.06; }
  .chip.is-dragging {
    cursor: grabbing;
    scale: 1.1;
    rotate: 0deg;
    z-index: 10;
    transition: none;
  }

  .chip--email {
    width: 74px;
    height: 74px;
    border-radius: 14px;
    background: var(--blue);
    color: #fff;
  }
  .chip--instagram {
    width: 94px;
    height: 94px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
  }
  .chip--youtube {
    width: 110px;
    height: 46px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
  }
  .chip--tiktok {
    width: 62px;
    height: 62px;
    border-radius: 14px;
    background: var(--brown);
    color: #fff;
  }
  .chip--linkedin {
    width: 110px;
    height: 46px;
    border-radius: 999px;
    background: var(--green);
    color: #fff;
  }
</style>

<script>
  // "find me" game — drag the sticker chips to reveal the portrait.
  // A short drag suppresses the link's click; a plain tap still follows it.
  const game = document.querySelector<HTMLElement>('.find-game');
  if (game) {
    game.querySelectorAll<HTMLAnchorElement>('.chip').forEach((chip) => {
      let dragging = false;
      let moved = false;
      let sx = 0;
      let sy = 0;
      let bx = 0;
      let by = 0;

      chip.addEventListener('pointerdown', (e) => {
        dragging = true;
        moved = false;
        sx = e.clientX;
        sy = e.clientY;
        bx = chip.offsetLeft;
        by = chip.offsetTop;
        chip.setPointerCapture(e.pointerId);
        chip.classList.add('is-dragging');
      });

      chip.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - sx;
        const dy = e.clientY - sy;
        if (Math.abs(dx) > 3 || Math.abs(dy) > 3) moved = true;
        const maxX = Math.max(game.clientWidth - chip.offsetWidth, 0);
        const maxY = Math.max(game.clientHeight - chip.offsetHeight, 0);
        chip.style.left = `${Math.min(Math.max(bx + dx, 0), maxX)}px`;
        chip.style.top = `${Math.min(Math.max(by + dy, 0), maxY)}px`;
      });

      const end = () => {
        dragging = false;
        chip.classList.remove('is-dragging');
      };
      chip.addEventListener('pointerup', end);
      chip.addEventListener('pointercancel', end);
      chip.addEventListener('click', (e) => {
        if (moved) e.preventDefault();
      });
    });
  }
</script>
