---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import shortFilms from '../assets/work-short-films.jpg';
import freelance from '../assets/work-freelance.png';
import creative from '../assets/work-creative.jpg';
import research from '../assets/work-research.jpg';

const cards = [
  { label: 'short films', href: '/shorts/', img: shortFilms },
  { label: 'freelance', href: '/freelance/', img: freelance },
  { label: 'creative\ncontent', href: '/content/', img: creative },
  { label: 'research', href: '/research/', img: research },
];

const comingSoon = [
  { label: 'watersprite\nfilm festival' },
  { label: 'photography' },
];
---

<BaseLayout title="Work">
  <h1 class="page-title reveal">Work</h1>

  <div class="grid">
    {cards.map((c) => (
      <a class="tile reveal" href={c.href}>
        <span class="tile-label">
          {c.label}
          <span class="orbit" aria-hidden="true"><span class="orbit-mover"><i class="orbit-dot"></i></span></span>
        </span>
        <Image
          class="tile-img"
          src={c.img}
          alt=""
          widths={[400, 720, 1000]}
          sizes="(max-width: 760px) 92vw, 480px"
          loading="lazy"
        />
      </a>
    ))}
    {comingSoon.map((c) => (
      <div class="tile tile--soon reveal" aria-label={`${c.label.replace('\n', ' ')} — coming soon`}>
        <span class="tile-label">
          {c.label}<br /><small>coming soon</small>
          <span class="orbit" aria-hidden="true"><span class="orbit-mover"><i class="orbit-dot"></i></span></span>
        </span>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    max-width: 880px;
    margin-inline: auto;
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
  .tile {
    position: relative;
    aspect-ratio: 1.9 / 1;
    display: grid;
    place-items: center;
    background: var(--yellow);
    text-decoration: none;
    overflow: hidden;
    border-radius: 2px;
    transition: transform 0.2s ease;
  }
  .tile:hover { transform: translateY(-3px); }
  .tile-label {
    position: relative;
    z-index: 2;
    font-size: clamp(1.5rem, 3.4vw, 2.1rem);
    line-height: 1.05;
    text-align: center;
    white-space: pre-line;
    transition: opacity 0.3s ease, color 0.3s ease;
  }
  .tile-label small {
    display: block;
    margin-top: 0.35em;
    font-size: 0.45em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .tile-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 1;
  }
  .tile:hover .tile-img,
  .tile:focus-visible .tile-img { opacity: 1; }
  .tile:hover .tile-label { color: #fff; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4); }
  /* on touch there is no hover: the photo shows while the tile is near the
     middle of the screen and fades back to yellow as it scrolls away
     (the original site's behaviour — driven by the page script below) */
  @media (hover: none) {
    .tile-img {
      opacity: var(--img-o, 1);
      transition: opacity 0.25s ease;
    }
    .tile.tile--photo .tile-label {
      color: #fff;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
    }
  }
  .tile--soon { cursor: default; }

  /* mobile: tiles are single-column and full-width, so the labels
     can be much bigger — closer to the original's proportion */
  @media (max-width: 640px) {
    .tile-label { font-size: clamp(2rem, 9vw, 2.6rem); }
    .tile-label small { font-size: 0.4em; }
  }

  /* a small red circle that spins around the text while the tile is
     hovered, and disappears again when it isn't. The elliptical path is
     built from 12 translate keyframes (box-relative percentages), so it
     works in every browser — no offset-path needed. */
  .orbit {
    position: absolute;
    inset: -0.65em -1.1em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .tile:hover .orbit,
  .tile:focus-visible .orbit { opacity: 1; }

  .orbit-mover { position: absolute; inset: 0; }
  .orbit-dot {
    position: absolute;
    top: -14px;
    left: -14px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 2px 6px rgba(34, 34, 34, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit-mover { translate: 50% 0; } /* park the dot above the text */
  }
  @media (prefers-reduced-motion: no-preference) {
    .tile:hover .orbit-mover,
    .tile:focus-visible .orbit-mover {
      animation: orbit-travel 2.1s linear infinite;
    }
  }
  /* 30° stops around an ellipse inscribed in the orbit box
     (x = 50% + 50%·cos θ, y = 50% + 50%·sin θ, clockwise) */
  @keyframes orbit-travel {
    0% { translate: 100% 50%; }
    8.3% { translate: 93.3% 75%; }
    16.7% { translate: 75% 93.3%; }
    25% { translate: 50% 100%; }
    33.3% { translate: 25% 93.3%; }
    41.7% { translate: 6.7% 75%; }
    50% { translate: 0% 50%; }
    58.3% { translate: 6.7% 25%; }
    66.7% { translate: 25% 6.7%; }
    75% { translate: 50% 0%; }
    83.3% { translate: 75% 6.7%; }
    91.7% { translate: 93.3% 25%; }
    100% { translate: 100% 50%; }
  }
</style>

<script>
  // Scroll-driven tile reveal on touch devices (no hover there): a tile
  // shows its photo while it sits near the middle of the screen and
  // fades back to the yellow box as it scrolls up or down — the original
  // site's behaviour. Desktop keeps the hover reveal.
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.tile'));
  const touch = matchMedia('(hover: none)').matches;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (touch && tiles.length && !reduced) {
    const update = () => {
      const mid = innerHeight / 2;
      for (const t of tiles) {
        const r = t.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - mid) / (innerHeight / 2);
        // full photo within the middle band of the screen, fully yellow
        // once the tile's centre passes ~87% of the half-viewport
        const o = Math.min(1, Math.max(0, 1 - Math.max(0, d - 0.2) * 1.5));
        t.style.setProperty('--img-o', o.toFixed(3));
        t.classList.toggle('tile--photo', o > 0.45);
      }
    };
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>
