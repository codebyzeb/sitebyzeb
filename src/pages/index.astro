---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import poster from '../assets/home-video-poster.png';
---

<BaseLayout title="SiteByZeb">
  <section class="hero">
    <div class="hero-video reveal">
      <div class="deco deco--circle" aria-hidden="true"></div>
      <div class="deco deco--flag" aria-hidden="true"></div>
      <div class="deco deco--para" aria-hidden="true"></div>
      <VideoEmbed
        provider="vimeo"
        id="1226923169"
        title="Zeb Goriely — showreel"
        expandable
      >
        <img slot="poster" class="embed-poster" src={poster.src} alt="" />
      </VideoEmbed>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: clamp(2rem, 6vw, 4rem) 0 clamp(3rem, 8vw, 5rem);
  }
  .hero-video {
    position: relative;
    max-width: 640px;
    margin-inline: auto;
  }
  /* shapes peeking from behind the video panel, like the original:
     red circle at the top-right corner, yellow flag pointing down on the
     left edge at mid-height, blue parallelogram along the bottom edge */
  .deco--circle {
    top: -38px;
    right: -38px;
    width: 108px;
    height: 108px;
    border-radius: 50%;
    background: var(--red);
    z-index: -1;
  }
  .deco--flag {
    left: -38px;
    top: 38%;
    width: 0;
    height: 0;
    border-top: 52px solid var(--yellow-note);
    border-left: 44px solid transparent;
    border-right: 26px solid transparent;
    rotate: 12deg;
    z-index: -1;
  }
  .deco--para {
    bottom: -26px;
    right: 9%;
    width: 132px;
    height: 60px;
    background: var(--blue);
    transform: skewX(-18deg) rotate(-5deg);
    z-index: -1;
  }
</style>
