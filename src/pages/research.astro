---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import {
  PAPERS,
  PRESENTATIONS,
  RESEARCH_BIO,
  RESEARCH_PORTRAIT,
  RESEARCH_THEMES,
  TEACHING,
} from '../data/research';
import paperPortrait from '../assets/research-paper-portrait.svg';
---

<BaseLayout title="Research">
  <section class="hero-panel reveal">
    <Image
      class="portrait"
      src={RESEARCH_PORTRAIT}
      alt="Portrait of Zeb Goriely"
      widths={[320, 480]}
      sizes="(max-width: 700px) 80vw, 280px"
      loading="eager"
    />
    <div class="hero-copy">
      <h1 class="section-heading">Research</h1>
      <div class="bio">
        {RESEARCH_BIO.map((p) => <p class="prose bio-p">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="reveal">
    <h2 class="list-heading">Research Themes</h2>
    <ul class="themes">
      {RESEARCH_THEMES.map((t) => <li class="theme">{t}</li>)}
    </ul>
  </section>

  <section class="reveal">
    <h2 class="list-heading">Papers</h2>
    <div class="papers">
      {PAPERS.map((p) => (
        <a class="paper" href={p.href} target="_blank" rel="noopener">
          <Image src={paperPortrait} alt="" width={46} loading="lazy" />
          <span class="paper-title">{p.title}</span>
          <span class="paper-venue subtitle">{p.venue}</span>
          <span class="paper-year subtitle">{p.year}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="reveal">
    <h2 class="list-heading">Teaching</h2>
    <div class="teaching">
      <p class="prose">{TEACHING.intro}</p>
      <ul class="courses">
        {TEACHING.courses.map((c) => <li>{c}</li>)}
      </ul>
      <p class="prose">{TEACHING.outro}</p>
    </div>
  </section>

  <section class="reveal">
    <h2 class="list-heading">Presentations</h2>
    <div class="presentations">
      {PRESENTATIONS.map((p) => (
        <figure class="presentation">
          <figcaption>
            <p class="p-title">{p.title}</p>
            <p class="subtitle p-detail">{p.detail}</p>
            <p class="subtitle p-when">{p.when}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    background: var(--brown);
    border-radius: 2px;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    margin-top: clamp(2rem, 6vw, 3rem);
  }
  .portrait {
    width: 200px;
    flex: 0 0 auto;
    border-radius: 2px;
    box-shadow: 0 14px 28px -12px rgba(34, 34, 34, 0.4);
  }
  .hero-copy { flex: 1 1 300px; color: #fff; }
  .hero-copy .section-heading { color: #fff; margin-bottom: 1rem; }
  .bio { display: flex; flex-direction: column; gap: 0.8em; }
  .bio-p { color: rgba(255, 255, 255, 0.88); }

  .list-heading {
    font-size: var(--size-h3);
    font-weight: 400;
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 1.25rem;
    text-align: center;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 2px;
  }

  .themes {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    max-width: 720px;
    margin-inline: auto;
  }
  .theme {
    background: var(--red);
    color: #fff;
    border-radius: 999px;
    padding: 0.5em 1.35em;
    font-size: var(--size-small);
  }

  .papers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.25rem;
    max-width: 900px;
    margin-inline: auto;
  }
  .paper {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 2px;
    padding: 1.25rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .paper:hover {
    transform: translateY(-3px);
    box-shadow: 4px 4px 0 var(--yellow);
  }
  .paper :global(img) { width: 40px; height: auto; margin-bottom: 0.5rem; }
  .paper-title { line-height: 1.3; }
  .paper-venue { margin-top: auto; padding-top: 0.5rem; }

  .teaching { max-width: 620px; margin-inline: auto; text-align: left; }
  .courses {
    margin: 1em 0 1em 1.25em;
    display: flex;
    flex-direction: column;
    gap: 0.35em;
  }

  .presentations {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 820px;
    margin-inline: auto;
  }
  @media (max-width: 640px) {
    .presentations { grid-template-columns: 1fr; }
  }
  .presentation {
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 2px;
    padding: 1.25rem;
  }
  .p-title { line-height: 1.3; margin-bottom: 0.5rem; }
  .p-when { margin-top: 0.35rem; }
</style>
