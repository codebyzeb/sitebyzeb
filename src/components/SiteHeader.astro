---
const path = Astro.url.pathname;
const isActive = (prefix: string) =>
  prefix === '/' ? path === '/' : path.startsWith(prefix);

const links = [
  { label: 'site', rest: 'byzeb', href: '/', variant: 'note' },
  { label: 'work', rest: 'byzeb', href: '/work/', variant: 'triangle' },
  { label: 'info', rest: 'byzeb', href: '/info/', variant: 'star' },
];

const navWords = [
  { label: 'SiteByZeb', href: '/', mini: 'site', delay: '0.05s' },
  { label: 'WorkByZeb', href: '/work/', mini: 'work', delay: '0.15s' },
  { label: 'InfoByZeb', href: '/info/', mini: 'info', delay: '0.25s' },
];
---

<header class="site-header">
  <a class="site-title" href="/">Zeb Goriely</a>
  <nav class="nav-row" aria-label="Main">
    {links.map((l, i) => (
      <a
        class:list={['sticker', `sticker--${l.variant}`]}
        href={l.href}
        aria-current={isActive(l.href) ? 'page' : undefined}
        style={`--i: ${i}`}
      >
        <span class="shape" aria-hidden="true"></span>
        <span class="label">
          {l.label}<span class="rest">{l.rest}</span>
        </span>
      </a>
    ))}
  </nav>

  <!-- mobile: three-line menu opening a full-screen nav page (like the original) -->
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-overlay"
    aria-label="Menu"
  >
    <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
  </button>
  <div class="nav-overlay" id="nav-overlay">
    <nav class="nav-overlay-links" aria-label="Menu">
      {navWords.map((l) => (
        <a class="nav-word" href={l.href} style={`--d: ${l.delay}`}>
          <span class:list={['shape-mini', `shape-mini--${l.mini}`]} aria-hidden="true"></span>
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // One playful 360° spin of the sticker shape on hover/focus. Uses the Web
  // Animations API so the spin always finishes, even if the pointer leaves
  // mid-animation (a CSS :hover animation would snap back).
  const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stickers = document.querySelectorAll<HTMLElement>('.site-header .sticker');
  for (const sticker of stickers) {
    const shape = sticker.querySelector<HTMLElement>('.shape');
    if (!shape) continue;
    const spin = () => {
      if (prefersReduced || shape.getAnimations().length) return;
      const tilt = parseFloat(
        getComputedStyle(shape).getPropertyValue('--tilt') || '0deg'
      );
      shape.animate(
        [
          { rotate: `${tilt}deg` },
          { rotate: `${tilt + 360}deg` },
        ],
        { duration: 550, easing: 'ease-out' }
      );
    };
    sticker.addEventListener('pointerenter', spin);
    sticker.addEventListener('focusin', spin);
  }

  // Mobile menu: three-line toggle opens the full-screen nav page.
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const overlay = document.querySelector<HTMLElement>('.nav-overlay');
  if (toggle && overlay) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      overlay.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    overlay.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
