---
const path = Astro.url.pathname;
const isActive = (prefix: string) =>
  prefix === '/' ? path === '/' : path.startsWith(prefix);
---

<header class="site-header">
  <a class="site-title" href="/">Zeb Goriely</a>
  <nav class="nav-row" aria-label="Main">
    <a class="sticker sticker--note" href="/" aria-current={isActive('/') ? 'page' : undefined}>
      Site
    </a>
    <a
      class="sticker sticker--triangle"
      href="/work/"
      aria-current={isActive('/work') ? 'page' : undefined}
    >
      Work
    </a>
    <a
      class="sticker sticker--star"
      href="/info/"
      aria-current={isActive('/info') ? 'page' : undefined}
    >
      Info
    </a>
  </nav>
</header>
