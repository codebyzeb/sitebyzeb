---
// A single red circle that draws itself around a label on hover —
// used by the Work page tiles ("pen circling the text").
---

<svg class="circle-mark" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
  <ellipse
    cx="50"
    cy="20"
    rx="45"
    ry="15"
    transform="rotate(-4 50 20)"
    pathLength="100"
    vector-effect="non-scaling-stroke"
  ></ellipse>
</svg>
