---
/*
 * VideoEmbed — faithful + performant video embeds.
 *
 * - youtube / vimeo: click-to-load facade (poster + play button), so no
 *   third-party JS loads until the visitor presses play.
 * - vertical YouTube Shorts render at 9/16.
 * - tiktok: lazy iframe (official embed).
 */
interface Props {
  provider: 'youtube' | 'vimeo' | 'tiktok';
  id: string; // video id (yt / vimeo / tiktok numeric id)
  title?: string;
  vertical?: boolean; // 9:16 YouTube Shorts
  expandable?: boolean; // grows on hover, grows more + locks once playing
}

const { provider, id, title = 'Video', vertical = false, expandable = false } = Astro.props;

const embedUrl =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`
    : provider === 'vimeo'
      ? `https://player.vimeo.com/video/${id}?autoplay=1`
      : `https://www.tiktok.com/embed/v2/${id}`;

const poster =
  provider === 'youtube'
    ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg`
    : provider === 'vimeo'
      ? undefined // vimeo posters passed via slot
      : undefined;
---

{provider === 'tiktok' ? (
  <div class="embed embed--tiktok" data-embed-url={embedUrl}>
    <div class="embed-loading" />
  </div>
) : (
  <div
    class:list={['embed', 'embed--facade', { 'is-vertical': vertical, 'embed--expandable': expandable }]}
    data-embed-url={embedUrl}
    role="button"
    tabindex="0"
    aria-label={`Play ${title}`}
  >
    {provider === 'vimeo' ? (
      <slot name="poster" />
    ) : (
      <img class="embed-poster" src={poster} alt="" loading="lazy" />
    )}
    <span class="play" aria-hidden="true">
      <svg viewBox="0 0 100 100">
        <path
          d="M36 27 L73 50 L36 73 Z"
          fill="#fff"
          stroke="#fff"
          stroke-width="9"
          stroke-linejoin="round"
        />
      </svg>
    </span>
  </div>
)}

<style>
  .embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 2px;
    overflow: hidden;
    background: #1a1a1a;
    box-shadow: 0 14px 28px -14px rgba(34, 34, 34, 0.45);
  }
  .embed.is-vertical { aspect-ratio: 9 / 16; max-width: 320px; }
  .embed :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .embed--facade { cursor: pointer; }
  .embed--facade:hover .play,
  .embed--facade:focus-visible .play { transform: scale(1.12); }

  /* expandable: slight growth on hover, bigger + locked once playing */
  .embed--expandable {
    transition: scale 0.35s cubic-bezier(0.2, 0.8, 0.3, 1);
    will-change: scale;
  }
  .embed--expandable:not(.is-locked):hover {
    scale: 1.045;
  }
  .embed--expandable.is-locked {
    scale: 1.14;
    z-index: 5;
  }
  .embed-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 3;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--ink);
    color: var(--ink);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    display: none;
    place-items: center;
    padding: 0;
    font-family: var(--font-caption);
  }
  .embed--expandable.is-locked .embed-close { display: grid; }
  .embed-close:hover { background: var(--yellow-note); }
  .embed-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    /* slight right shift — optical centring for a triangle */
    translate: calc(-50% + 3%) -50%;
    width: clamp(40px, 9%, 64px);
    height: clamp(40px, 9%, 64px);
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4));
    transition: transform 0.15s ease;
  }
  .play svg { width: 100%; height: 100%; display: block; }
  .embed--tiktok {
    background: transparent;
    box-shadow: none;
    aspect-ratio: 9 / 16;
    max-width: 340px;
    margin-inline: auto;
  }
</style>

<script>
  // Click-to-load facades + lazy tiktok iframes
  const facades = document.querySelectorAll<HTMLElement>('.embed--facade');
  for (const f of facades) {
    const facadeMarkup = f.innerHTML;
    const activate = () => {
      if (f.dataset.loaded) return;
      f.dataset.loaded = '1';
      const iframe = document.createElement('iframe');
      iframe.src = f.dataset.embedUrl ?? '';
      iframe.title = 'Embedded video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      f.innerHTML = '';
      f.appendChild(iframe);
      // expandable: lock into the larger size while playing, with a close
      // button that restores the poster facade
      if (f.classList.contains('embed--expandable')) {
        f.classList.add('is-locked');
        const close = document.createElement('button');
        close.className = 'embed-close';
        close.type = 'button';
        close.setAttribute('aria-label', 'Close video');
        close.textContent = '\u2715';
        close.addEventListener('click', (ev) => {
          ev.stopPropagation();
          f.classList.remove('is-locked');
          f.dataset.loaded = '';
          f.innerHTML = facadeMarkup;
        });
        f.appendChild(close);
      }
    };
    f.addEventListener('click', activate);
    f.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activate();
      }
    });
  }

  const tiktoks = document.querySelectorAll<HTMLElement>('.embed--tiktok');
  if (tiktoks.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            const el = en.target as HTMLElement;
            const iframe = document.createElement('iframe');
            iframe.src = el.dataset.embedUrl ?? '';
            iframe.title = 'TikTok video';
            iframe.allow = 'encrypted-media; picture-in-picture';
            iframe.allowFullscreen = true;
            el.innerHTML = '';
            el.appendChild(iframe);
            io.unobserve(el);
          }
        }
      },
      { rootMargin: '200px' }
    );
    tiktoks.forEach((t) => io.observe(t));
  }
</script>
